<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="defs_sub_v2" targetNamespace="http://bpmndiff.org/taxonomy">
  <process id="proc_sub" name="Clinical and Billing Check (v2)">
    <startEvent id="start" name="Admission request" />
    <subProcess id="sub_medical" name="Clinical verification">
      <task id="t1" name="Verify lab results" />
      <task id="t2" name="Consult specialist" />
    </subProcess>
    <task id="t3" name="Check insurance coverage" />
    <task id="t4" name="Authorize discount" />
    <endEvent id="end" name="Admission approved" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="sub_medical" />
    <sequenceFlow id="f2" sourceRef="sub_medical" targetRef="t3" />
    <sequenceFlow id="f3" sourceRef="t3" targetRef="t4" />
    <sequenceFlow id="f4" sourceRef="t4" targetRef="end" />
  </process>
</definitions>
