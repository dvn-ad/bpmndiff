<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="defs_sub_v1" targetNamespace="http://bpmndiff.org/taxonomy">
  <process id="proc_sub" name="Clinical and Billing Check (v1)">
    <startEvent id="start" name="Admission request" />
    <task id="t1" name="Verify lab results" />
    <task id="t2" name="Consult specialist" />
    <subProcess id="sub_bill" name="Billing verification">
      <task id="t3" name="Check insurance coverage" />
      <task id="t4" name="Authorize discount" />
    </subProcess>
    <endEvent id="end" name="Admission approved" />

    <sequenceFlow id="f1" sourceRef="start" targetRef="t1" />
    <sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <sequenceFlow id="f3" sourceRef="t2" targetRef="sub_bill" />
    <sequenceFlow id="f4" sourceRef="sub_bill" targetRef="end" />
  </process>
</definitions>
