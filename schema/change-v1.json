{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmndiff.local/schema/change-v1.json",
  "title": "bpmndiff change event v1",
  "description": "One detected BPMN change and its supporting evidence.",
  "type": "object",
  "required": ["schema_version", "change", "evidence"],
  "properties": {
    "schema_version": {
      "const": "change-v1"
    },
    "change": {
      "$ref": "#/$defs/change"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "change": {
      "type": "object",
      "required": [
        "type",
        "legacy_type",
        "category",
        "category_name",
        "element",
        "before",
        "after",
        "detail",
        "confidence",
        "needs_review"
      ],
      "properties": {
        "type": {
          "enum": [
            "INSERT_NODE",
            "DELETE_NODE",
            "RENAME_NODE",
            "NODE_TYPE_CHANGE",
            "MARKER_CHANGE",
            "BOUNDARY_CHANGE",
            "MOVE_LANE",
            "RENAME_LANE",
            "INSERT_LANE",
            "DELETE_LANE",
            "GATEWAY_TYPE_CHANGE",
            "INSERT_FLOW",
            "DELETE_FLOW",
            "FLOW_CONDITION_CHANGE",
            "REORDER",
            "PARALLELIZE",
            "SEQUENTIALIZE",
            "EXTRACT_SUBPROCESS",
            "INLINE_SUBPROCESS",
            "MESSAGE_FLOW_CHANGE",
            "DATA_CHANGE"
          ]
        },
        "legacy_type": {
          "type": "string"
        },
        "category": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "category_name": {
          "type": "string"
        },
        "element": {
          "enum": [
            "node",
            "gateway",
            "boundary_event",
            "swimlane",
            "flow",
            "subprocess",
            "message_flow",
            "data"
          ]
        },
        "before": {
          "type": ["object", "null"]
        },
        "after": {
          "type": ["object", "null"]
        },
        "detail": {
          "type": "string"
        },
        "label": {
          "enum": ["identical", "synonym", "meaning_changed", "unmatched"]
        },
        "subtype": {
          "enum": ["synonym", "meaning_changed"]
        },
        "is_synonym": {
          "type": "boolean"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "needs_review": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["alignment", "structural_context", "observations"],
      "properties": {
        "alignment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alignment_evidence"
          }
        },
        "structural_context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structural_context"
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      },
      "additionalProperties": true
    },
    "alignment_evidence": {
      "type": "object",
      "required": [
        "reference_node_id",
        "variant_node_id",
        "label",
        "score",
        "reason",
        "confidence",
        "needs_review"
      ],
      "properties": {
        "reference_node_id": {
          "type": ["string", "null"]
        },
        "variant_node_id": {
          "type": ["string", "null"]
        },
        "label": {
          "enum": ["identical", "synonym", "meaning_changed", "unmatched"]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string"
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "needs_review": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "structural_context": {
      "type": "object",
      "required": ["reference", "variant", "matched_neighbors"],
      "properties": {
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/node_context"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant": {
          "anyOf": [
            {
              "$ref": "#/$defs/node_context"
            },
            {
              "type": "null"
            }
          ]
        },
        "matched_neighbors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/matched_neighbor"
          }
        }
      },
      "additionalProperties": true
    },
    "node_context": {
      "type": "object",
      "required": [
        "node_id",
        "predecessor_ids",
        "successor_ids",
        "in_degree",
        "out_degree"
      ],
      "properties": {
        "node_id": {
          "type": "string"
        },
        "predecessor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "successor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "in_degree": {
          "type": "integer",
          "minimum": 0
        },
        "out_degree": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "matched_neighbor": {
      "type": "object",
      "required": ["direction", "reference_node_id", "variant_node_id"],
      "properties": {
        "direction": {
          "enum": ["predecessor", "successor"]
        },
        "reference_node_id": {
          "type": "string"
        },
        "variant_node_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "observation": {
      "type": "object",
      "required": ["source", "description"],
      "properties": {
        "source": {
          "enum": ["alignment", "graph", "attribute", "lane", "data", "operation"]
        },
        "description": {
          "type": "string"
        },
        "value": {}
      },
      "additionalProperties": true
    }
  }
}
